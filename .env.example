# File mẫu liệt kê các biến môi trường cần thiết để chạy API, domain migrations và migration probe ở local.
PORT=8080

# Application/development database.
DATABASE_URL=postgres://nexus:nexus_dev_password@localhost:5432/nexus_commerce?sslmode=disable

# Isolated database for domain migrations and database integration tests.
TEST_DATABASE_URL=postgres://nexus:nexus_dev_password@localhost:5432/nexus_commerce_test?sslmode=disable

# Separate database for the DB-004A migration-engine probe so version 000001 cannot collide with domain migrations.
MIGRATION_PROBE_DATABASE_URL=postgres://nexus:nexus_dev_password@localhost:5432/nexus_commerce_migration_probe?sslmode=disable

DATABASE_MAX_CONNS=20
DATABASE_MIN_CONNS=2
DATABASE_MAX_CONN_LIFETIME=1h
DATABASE_MAX_CONN_IDLE_TIME=30m
DATABASE_HEALTH_CHECK_PERIOD=1m
DATABASE_STARTUP_TIMEOUT=5s

# Generate a private key outside the repository; keep it unreadable to other users.
# mkdir -p secrets
# openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072 -out secrets/access-token-rsa-private.pem
# chmod 600 secrets/access-token-rsa-private.pem
AUTH_ACCESS_TOKEN_PRIVATE_KEY_FILE=./secrets/access-token-rsa-private.pem
AUTH_ACCESS_TOKEN_ISSUER=nexus-commerce
AUTH_ACCESS_TOKEN_AUDIENCE=nexus-commerce-api
AUTH_ACCESS_TOKEN_CLIENT_ID=nexus-commerce
AUTH_ACCESS_TOKEN_KEY_ID=local-rsa-1
AUTH_ACCESS_TOKEN_TTL=15m
